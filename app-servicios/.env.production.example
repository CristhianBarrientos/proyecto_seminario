# Plantilla del entorno con el que se compila el APK (y cualquier build de produccion).
# Copiar a `.env.production.local` (ignorado por git) y completar la anon key de PRODUCCION.
#
# IMPORTANTE: el APK hornea estos valores en el codigo. El `.env` de desarrollo apunta a localhost y NO sirve
# en un celular. El script scripts/build-apk.ps1 aborta si la URL no es la de produccion o si el resultado
# compilado contiene "localhost".
VITE_SUPABASE_URL=https://api.yaquedo.shop
VITE_SUPABASE_ANON_KEY=<anon key de produccion (la misma que usa app.yaquedo.shop; es publica por diseño)>
